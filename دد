@keyframes haloBreathe{50%{box-shadow:0 0 110px rgba(217,181,111,.22),inset 0 0 100px rgba(217,181,111,.12)}}
.floatTag{backdrop-filter:blur(14px);animation:floatTag 6s ease-in-out infinite}
@keyframes floatTag{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-13px) rotate(2deg)}}
.project{isolation:isolate}
.project:after{content:"";position:absolute;inset:-1px;z-index:-1;border-radius:inherit;padding:1px;background:linear-gradient(130deg,transparent 20%,rgba(217,181,111,.65),transparent 75%);mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude;opacity:0;transition:opacity .4s}
.project:hover:after{opacity:1}
.projectArt{isolation:isolate}
.projectArt:after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 25%,rgba(255,255,255,.07) 48%,transparent 68%);transform:translateX(-120%);transition:transform .9s var(--ease-out);z-index:0}
.project:hover .projectArt:after{transform:translateX(120%)}
.artIcon{animation:iconFloat 5s ease-in-out infinite}
@keyframes iconFloat{50%{translate:0 -8px}}
.service{position:relative;overflow:hidden}
.service:after{content:"";position:absolute;width:150px;height:150px;right:-90px;top:-90px;border-radius:50%;background:var(--glow);filter:blur(25px);transition:.5s}
.service:hover:after{transform:scale(2.1)}
.serviceIcon{transition:transform .45s var(--ease-spring),box-shadow .3s}
.service:hover .serviceIcon{transform:rotate(-12deg) scale(1.12);box-shadow:0 10px 28px var(--glow)}
.sectionHead h2{position:relative}
.sectionHead h2:after{content:"";display:inline-block;width:42px;height:2px;margin-right:13px;vertical-align:middle;background:linear-gradient(90deg,var(--gold),transparent)}
.reveal{filter:blur(5px);transition:opacity .9s var(--ease-out),transform .9s var(--ease-out),filter .9s}
.reveal.visible{filter:blur(0)}
.step{position:relative;overflow:hidden;transition:transform .35s,border-color .35s}
.step:hover{transform:translateY(-7px);border-color:var(--gold)}
.step:after{content:"";position:absolute;bottom:0;right:0;width:0;height:2px;background:var(--gold);transition:width .5s var(--ease-out)}
.step:hover:after{width:100%}
.cta{position:relative;overflow:hidden}
.cta:after{content:"";position:absolute;width:300px;height:300px;left:-140px;top:-180px;border:1px solid rgba(217,181,111,.2);border-radius:50%;box-shadow:0 0 0 28px rgba(217,181,111,.025),0 0 0 58px rgba(217,181,111,.02);pointer-events:none}
.btn{position:relative;overflow:hidden}
.btn:before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 25%,rgba(255,255,255,.23),transparent 75%);transform:translateX(-130%);transition:transform .7s}
.btn:hover:before{transform:translateX(130%)}
.btn span{transition:transform .3s}
.btn:hover span{transform:translate(-3px,-3px)}
.toTop{backdrop-filter:blur(15px)}
@media(max-width:650px){#starfield{opacity:.4}.cursor-aura{display:none}.heroVisual{perspective:900px}.heroCard{animation:floatMobile 6s ease-in-out infinite}@keyframes floatMobile{50%{transform:rotate(-2deg) translateY(-10px)}}.sectionHead h2:after{width:25px}.reveal{filter:none}}
@media(prefers-reduced-motion:reduce){#cinematic-loader{display:none!important}#starfield,.cursor-aura{display:none!important}.heroContent>*{animation:none!important}.heroCard,.halo,.floatTag,.artIcon{animation:none!important}.reveal{filter:none!important}}


.phone3d{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.has3d .heroCard{display:none}
.toolchips{gap:10px}.toolchips span{font-size:14px;padding:8px 16px;border-radius:99px;border:1px solid var(--line);color:var(--text)}
.projectLink{display:inline-block;margin-top:18px;color:var(--gold2);font-size:14px;border-bottom:1px solid var(--gold)}
